%% ============================================================
% SINGLE-PHOTON SCANNING CAMERA
% Gaussian Stars + Spatial Fibre Sampling
%
% Optical model:
%
% Gaussian star image
%       ↓
% Telescope focal plane
%       ↓
% 4.2 um single-mode fibre
%       ↓
% Fibre samples a small spatial area
%       ↓
% SPCM-AQRH
%       ↓
% Photon count
%       ↓
% Reconstructed SPC image
%
% ============================================================

clear;
clc;
close all;


%% ============================================================
% 1. TELESCOPE AND FIBRE
% ============================================================

FOCAL_LENGTH = 6459e-3;       % Telescope focal length [m]

FIBRE_DIAMETER = 4.2e-6;      % Fibre MFD / sampling diameter [m]

FIBRE_DIAMETER_UM = 4.2;      % Fibre size [um]


% Approximate angular sampling

angularSamplingRad = FIBRE_DIAMETER / FOCAL_LENGTH;

angularSamplingArcsec = ...
    angularSamplingRad * (180/pi) * 3600;


fprintf('Approximate fibre angular sampling = %.4f arcsec\n', ...
    angularSamplingArcsec);


%% ============================================================
% 2. FOCAL PLANE GRID
% ============================================================

IMAGE_WIDTH  = 100;
IMAGE_HEIGHT = 100;


% Use the fibre diameter as the spatial sampling pitch

PIXEL_SIZE_UM = FIBRE_DIAMETER_UM;


% Create focal-plane coordinates in micrometres

x = ((1:IMAGE_WIDTH) - (IMAGE_WIDTH+1)/2) ...
    * PIXEL_SIZE_UM;

y = ((1:IMAGE_HEIGHT) - (IMAGE_HEIGHT+1)/2) ...
    * PIXEL_SIZE_UM;


[X,Y] = meshgrid(x,y);


%% ============================================================
% 3. CREATE GAUSSIAN STAR FIELD
% ============================================================

starField = zeros(IMAGE_HEIGHT,IMAGE_WIDTH);


% [X pixel, Y pixel, brightness]

stars = [
    20, 30, 10e6;
    45, 35, 15e6;
    70, 50, 12e6;
    80, 75, 20e6;
    35, 80, 10e6;
    60, 90, 8e6
];


% Width of Gaussian star image

PSF_SIGMA_PIXELS = 1.5;


% Convert PSF width to micrometres

PSF_SIGMA_UM = PSF_SIGMA_PIXELS * PIXEL_SIZE_UM;


% Generate each Gaussian star

for k = 1:size(stars,1)

    starX = ...
        ((stars(k,1) - (IMAGE_WIDTH+1)/2) ...
        * PIXEL_SIZE_UM);

    starY = ...
        ((stars(k,2) - (IMAGE_HEIGHT+1)/2) ...
        * PIXEL_SIZE_UM);


    brightness = stars(k,3);


    % Gaussian PSF

    gaussianStar = brightness * ...
        exp( ...
        -((X-starX).^2 + (Y-starY).^2) ...
        /(2*PSF_SIGMA_UM^2) );


    % Add star to image

    starField = starField + gaussianStar;

end


%% ============================================================
% 4. DISPLAY ORIGINAL GAUSSIAN STAR IMAGE
% ============================================================

figure;

imagesc(x,y,starField);

axis image;

set(gca,'YDir','normal');

colormap(gray);

colorbar;

xlabel('Focal Plane X [\mum]');
ylabel('Focal Plane Y [\mum]');

title('Original Gaussian Star Field');


%% ============================================================
% 5. CREATE FIBRE SAMPLING AREA
% ============================================================

% Fibre is modelled as a small circular spatial sample.

fibreRadius = FIBRE_DIAMETER_UM / 2;


% Create local coordinate system around fibre

sampleRange = -fibreRadius:fibreRadius;

[FX,FY] = meshgrid(sampleRange,sampleRange);


% Circular fibre sampling mask

fibreMask = ...
    sqrt(FX.^2 + FY.^2) <= fibreRadius;


% Normalise mask

fibreMask = fibreMask / sum(fibreMask(:));


%% ============================================================
% 6. DETECTOR PARAMETERS
% ============================================================

PDE = 0.65;

DARK_COUNT_RATE = 101;          % counts/sec

INTEGRATION_TIME = 0.1;        % seconds


%% ============================================================
% 7. SCANNING PARAMETERS
% ============================================================

Nx = 50;
Ny = 50;


% Scan across the same focal-plane region

scanX = linspace(min(x),max(x),Nx);

scanY = linspace(min(y),max(y),Ny);


% Reconstructed image

SPC_image = zeros(Ny,Nx);


% Raw photon counts

photonCounts = zeros(Ny,Nx);


%% ============================================================
% 8. FIBRE SCAN
% ============================================================

fprintf('\n');
fprintf('Starting fibre spatial scan...\n');
fprintf('Scan size = %d x %d\n',Nx,Ny);


for j = 1:Ny

    for i = 1:Nx


        %% ----------------------------------------------------
        % CURRENT FIBRE POSITION
        % -----------------------------------------------------

        fibreX = scanX(i);
        fibreY = scanY(j);


        %% ----------------------------------------------------
        % FIND CLOSEST FOCAL-PLANE PIXEL
        % -----------------------------------------------------

        [~,ix] = min(abs(x-fibreX));
        [~,iy] = min(abs(y-fibreY));


        %% ----------------------------------------------------
        % SAMPLE REGION AROUND FIBRE
        % -----------------------------------------------------

        xMin = max(1, ix-floor(length(sampleRange)/2));
        xMax = min(IMAGE_WIDTH, ...
            ix+floor(length(sampleRange)/2));

        yMin = max(1, iy-floor(length(sampleRange)/2));
        yMax = min(IMAGE_HEIGHT, ...
            iy+floor(length(sampleRange)/2));


        sampledRegion = ...
            starField(yMin:yMax,xMin:xMax);


        %% ----------------------------------------------------
        % FIBRE COLLECTS LIGHT FROM SMALL SPATIAL AREA
        % -----------------------------------------------------

        % Resize mask if near image boundary

        maskHeight = size(sampledRegion,1);
        maskWidth  = size(sampledRegion,2);


        localMask = fibreMask( ...
            1:min(maskHeight,size(fibreMask,1)), ...
            1:min(maskWidth,size(fibreMask,2)));


        localRegion = sampledRegion( ...
            1:size(localMask,1), ...
            1:size(localMask,2));


        % Spatial overlap between star image and fibre

        collectedLight = ...
            sum(localRegion(:) .* localMask(:));


        %% ----------------------------------------------------
        % CONVERT LIGHT INTO EXPECTED PHOTONS
        % -----------------------------------------------------

        expectedPhotons = ...
            collectedLight * INTEGRATION_TIME;


        %% ----------------------------------------------------
        % DETECTOR EFFICIENCY
        % -----------------------------------------------------

        detectedPhotons = ...
            expectedPhotons * PDE;


        %% ----------------------------------------------------
        % DARK COUNTS
        % -----------------------------------------------------

        darkCounts = ...
            DARK_COUNT_RATE * INTEGRATION_TIME;


        %% ----------------------------------------------------
        % TOTAL EXPECTED COUNTS
        % -----------------------------------------------------

        totalExpectedCounts = ...
            detectedPhotons + darkCounts;


        %% ----------------------------------------------------
        % POISSON PHOTON COUNTING
        % -----------------------------------------------------

        measuredCount = ...
            poissrnd(totalExpectedCounts);


        %% ----------------------------------------------------
        % STORE COUNT
        % -----------------------------------------------------

        photonCounts(j,i) = measuredCount;

        SPC_image(j,i) = measuredCount;


    end

end


%% ============================================================
% 9. DISPLAY RECONSTRUCTED SPC IMAGE
% ============================================================

figure;

imagesc(scanX,scanY,SPC_image);

axis image;

set(gca,'YDir','normal');

colormap(gray);

colorbar;

xlabel('Fibre / Mirror X Position [\mum]');
ylabel('Fibre / Mirror Y Position [\mum]');

title('Reconstructed SPC Image');


%% ============================================================
% 10. DISPLAY COUNTS VS SCAN INDEX
% ============================================================

figure;

plot(photonCounts(:));

xlabel('Scan Index');

ylabel('Photon Count');

title('Photon Counts vs Scan Index');

grid on;


%% ============================================================
% 11. DISPLAY ORIGINAL AND RECONSTRUCTED IMAGE
% ============================================================

figure;

imagesc(scanX,scanY,SPC_image);

axis image;

set(gca,'YDir','normal');

colormap(gray);

colorbar;

xlabel('X Position [\mum]');
ylabel('Y Position [\mum]');

title('Single-Fibre Photon Scanning Reconstruction');


%% ============================================================
% 12. INFORMATION
% ============================================================

fprintf('\n');
fprintf('============================================\n');
fprintf('SINGLE-FIBRE SCANNING SIMULATION\n');
fprintf('============================================\n');

fprintf('Telescope focal length: %.3f mm\n', ...
    FOCAL_LENGTH*1000);

fprintf('Fibre diameter: %.1f um\n', ...
    FIBRE_DIAMETER_UM);

fprintf('Angular sampling: %.4f arcsec\n', ...
    angularSamplingArcsec);

fprintf('PSF sigma: %.2f pixels\n', ...
    PSF_SIGMA_PIXELS);

fprintf('PDE: %.0f %%\n',PDE*100);

fprintf('Integration time: %.3f seconds\n', ...
    INTEGRATION_TIME);

fprintf('Scan size: %d x %d\n',Nx,Ny);

fprintf('Total measurements: %d\n',Nx*Ny);

fprintf('============================================\n');
