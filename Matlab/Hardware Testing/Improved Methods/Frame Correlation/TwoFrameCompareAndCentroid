% ============================================================

fprintf('\n');
fprintf('============================================\n');
fprintf(' CENTROID RESULTS\n');
fprintf('============================================\n');

fprintf('\n');

fprintf([ ...
    'Source   Display X   Display Y   ' ...
    'Original X   Original Y   ' ...
    'Physical X      Physical Y      ' ...
    'Peak       Total      Pixels\n']);

fprintf([ ...
    '--------------------------------------------------------------------------------' ...
    '------------\n']);

for k = 1:numSources

    fprintf( ...
