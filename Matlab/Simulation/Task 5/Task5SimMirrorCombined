%% ============================================================
% TASK 5 - SINGLE-PHOTON SCANNING CAMERA
%
% Illuminated star map
%        ↓
%   Lens / telescope
%        ↓
% Beam-steering mirror
%        ↓
% Single-mode fibre
%        ↓
%    SPCM-AQRH
%
% The beam-steering mirror performs a 50 x 50 raster scan.
%
% CURRENT VERSION:
% The SPCM is not yet connected.
% The optical signal at each mirror position is simulated.
%
% FUTURE VERSION:
% Replace fibreLight with the actual SPCM photon count.
%
% ============================================================

clear;
clc;
close all;


%% ============================================================
% 1. CREATE ILLUMINATED STAR MAP
% ============================================================

MAP_WIDTH  = 50;
MAP_HEIGHT = 50;

% Empty star map

starMap = zeros(MAP_HEIGHT, MAP_WIDTH);


% Define illuminated objects
%
% [X position, Y position, brightness]

stars = [
    10, 15, 100;
    22, 18, 200;
    35, 25, 150;
    40, 38, 250;
    18, 40, 180;
    30, 45, 120
];


% Place stars into the star map

for k = 1:size(stars,1)

    x = stars(k,1);
    y = stars(k,2);
    brightness = stars(k,3);

    starMap(y,x) = brightness;

end


%% ============================================================
% 2. DEFINE SPC FIELD OF VIEW
% ============================================================

% Telescope effective focal length

focalLength = 6459;       % mm


% Single-mode fibre mode field diameter

fibreSize = 4.2e-3;       % mm
                          % 4.2 micrometres


% Calculate angular sampling size

SPC_FOV_arcsec = ...
    (fibreSize / focalLength) * 206265;


fprintf('SPC angular sampling size = %.4f arcsec\n', ...
    SPC_FOV_arcsec);


% ------------------------------------------------------------
% STAR-MAP PIXEL SCALE
% ------------------------------------------------------------
%
% Simplified first-order model:
%
% One star-map pixel represents one fibre sampling interval.
%
% Therefore:
%
% 1 star-map pixel ≈ 0.1341 arcsec
%
% ------------------------------------------------------------

STAR_PIXEL_SIZE_arcsec = SPC_FOV_arcsec;


% Fibre covers approximately one star-map pixel

FOV_SIZE = 1;

radius = floor(FOV_SIZE / 2);


% Create circular FOV

[xFOV, yFOV] = meshgrid(-radius:radius, ...
                        -radius:radius);

FOV = (xFOV.^2 + yFOV.^2 <= radius^2);


%% ============================================================
% 3. BEAM-STEERING MIRROR
% ============================================================

% Physical mirror communication

port = "COM4";             % Edit if required
baud = 256000;

mirror = serialport(port, baud);

configureTerminator(mirror, "CR/LF");

pause(0.1);


%% ============================================================
% 4. MIRROR HANDSHAKE
% ============================================================

writeline(mirror, "start");

pause(0.01);


%% ============================================================
% 5. MIRROR MOVEMENT FUNCTION
% ============================================================

% The function converts the desired scan position into
% a command for the beam-steering mirror.

function moveMirror(mirror,x,y)

    maxDef = tand(16.6) / tand(50);

    % Limit requested position

    x = max(min(x, maxDef), -maxDef);
    y = max(min(y, maxDef), -maxDef);

    % Create mirror command

    cmd = sprintf("xy= %0.4f; %0.4f", x, y);

    % Send command

    writeline(mirror, cmd);

    % Allow mirror time to respond

    pause(0.01);

end


%% ============================================================
% 6. CREATE 50 x 50 MIRROR SCAN
% ============================================================

% Number of scan positions

Nx = 50;
Ny = 50;


% Maximum mirror deflection

maxDef = tand(16.6) / tand(50);


% Generate equally spaced mirror positions

xs = linspace(-maxDef, maxDef, Nx);
ys = linspace(-maxDef, maxDef, Ny);


% Create 2D scan grid

[Xgrid, Ygrid] = meshgrid(xs, ys);


% Convert grid into sequential scan positions

scanX = Xgrid(:);
scanY = Ygrid(:);


% Total number of measurements

numMeasurements = length(scanX);


fprintf('\n');
fprintf('Total mirror scan positions: %d\n', ...
    numMeasurements);


%% ============================================================
% 7. CREATE OUTPUT IMAGE
% ============================================================

SPC_frame = zeros(Ny, Nx);


% Store simulated photon/light measurements

photonCounts = zeros(numMeasurements,1);


%% ============================================================
% 8. PERFORM MIRROR SCAN
% ============================================================

fprintf('\nStarting mirror scan...\n');


for k = 1:numMeasurements


    %% --------------------------------------------------------
    % Current physical mirror position
    % ---------------------------------------------------------

    currentX = scanX(k);
    currentY = scanY(k);


    %% --------------------------------------------------------
    % Move physical mirror
    % ---------------------------------------------------------

    moveMirror(mirror, currentX, currentY);


    %% --------------------------------------------------------
    % Convert scan number into star-map coordinates
    %
    % For this simplified model, the physical mirror scan
    % corresponds directly to a star-map pixel.
    % ---------------------------------------------------------

    ix = mod(k-1, Nx) + 1;
    iy = floor((k-1)/Nx) + 1;


    mirrorX = ix;
    mirrorY = iy;


    %% --------------------------------------------------------
    % Determine FOV boundaries
    % ---------------------------------------------------------

    xmin = mirrorX - radius;
    xmax = mirrorX + radius;

    ymin = mirrorY - radius;
    ymax = mirrorY + radius;


    %% --------------------------------------------------------
    % Check FOV remains inside star map
    % ---------------------------------------------------------

    if xmin < 1 || xmax > MAP_WIDTH || ...
       ymin < 1 || ymax > MAP_HEIGHT

        fibreLight = 0;

    else

        %% ----------------------------------------------------
        % Extract local scene
        % -----------------------------------------------------

        localScene = ...
            starMap(ymin:ymax, xmin:xmax);


        %% ----------------------------------------------------
        % Calculate light entering fibre
        % -----------------------------------------------------

        fibreLight = ...
            sum(localScene(FOV), 'all');

    end


    %% --------------------------------------------------------
    % CURRENT SIMULATION:
    %
    % fibreLight represents the measurement that would
    % eventually be replaced by the actual SPCM count.
    % ---------------------------------------------------------

    photonCounts(k) = fibreLight;


    %% --------------------------------------------------------
    % Store measurement in reconstructed image
    % ---------------------------------------------------------

    SPC_frame(iy,ix) = photonCounts(k);


    %% --------------------------------------------------------
    % Display progress
    % ---------------------------------------------------------

    fprintf('Scan %4d / %4d\n', ...
        k, numMeasurements);

end


%% ============================================================
% 9. RETURN MIRROR TO CENTRE
% ============================================================

moveMirror(mirror,0,0);


%% ============================================================
% 10. CLOSE SERIAL CONNECTION
% ============================================================

clear mirror;


%% ============================================================
% 11. DISPLAY ORIGINAL ILLUMINATED STAR MAP
% ============================================================

figure;

imagesc(starMap);

axis image;
set(gca,'YDir','normal');

colormap(gray);
colorbar;

xlabel('Star-map X position');
ylabel('Star-map Y position');

title('Original Illuminated Star Map');


%% ============================================================
% 12. DISPLAY RECONSTRUCTED SPC FRAME
% ============================================================

figure;

imagesc(SPC_frame);

axis image;
set(gca,'YDir','normal');

colormap(gray);
colorbar;

xlabel('Mirror Scan X');
ylabel('Mirror Scan Y');

title('SPC Frame from Beam-Steering Mirror Scan');


%% ============================================================
% 13. DISPLAY PHOTON COUNTS
% ============================================================

figure;

plot(photonCounts);

xlabel('Mirror Scan Index');
ylabel('Photon Count');

title('Photon Counts vs Mirror Scan Index');

grid on;


%% ============================================================
% 14. DISPLAY INFORMATION
% ============================================================

fprintf('\n');
fprintf('============================================\n');
fprintf('TASK 5 - SINGLE-PHOTON SCANNING CAMERA\n');
fprintf('============================================\n');

fprintf('Telescope focal length: %.0f mm\n', ...
    focalLength);

fprintf('Fibre MFD: %.1f micrometres\n', ...
    fibreSize * 1000);

fprintf('SPC angular sampling size: %.4f arcsec\n', ...
    SPC_FOV_arcsec);

fprintf('Star-map pixel scale: %.4f arcsec/pixel\n', ...
    STAR_PIXEL_SIZE_arcsec);

fprintf('Star map size: %d x %d pixels\n', ...
    MAP_WIDTH, MAP_HEIGHT);

fprintf('Mirror scan size: %d x %d\n', ...
    Nx, Ny);

fprintf('Total measurements: %d\n', ...
    numMeasurements);

fprintf('============================================\n');
