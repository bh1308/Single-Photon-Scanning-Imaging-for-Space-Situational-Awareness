using System;
using System.Collections.Generic;
using System.Globalization;
using System.IO;
using System.IO.Ports;
using System.Windows.Forms;
using NationalInstruments.DAQmx;
using Task = NationalInstruments.DAQmx.Task;

namespace SinglePhotonCamera
{
    public class MainForm : Form
    {
        // UI
        private TextBox countTextBox;
        private Button startButton;
        private Button stopButton;

        // DAQ
        private Task myTask;
        private CounterReader counterReader;
        private uint previousReading = 0;

        // Mirror
        private SerialPort mirrorPort;

        // Scan
        private List<(double X, double Y)> scanPoints;
        private int scanIndex = 0;

        // CSV
        private string csvFilename;
        private List<ScanResult> results;

        private class ScanResult
        {
            public int Position;
            public double X;
            public double Y;
            public uint Count;
        }

        public MainForm()
        {
            InitializeUI();
        }

        private void InitializeUI()
        {
            this.Text = "Single Photon Camera";
            this.Width = 400;
            this.Height = 200;

            countTextBox = new TextBox
            {
                Location = new System.Drawing.Point(20, 20),
                Width = 100,
                ReadOnly = true
            };

            startButton = new Button
            {
                Location = new System.Drawing.Point(20, 60),
                Text = "Start"
            };
            startButton.Click += startButton_Click;

            stopButton = new Button
            {
                Location = new System.Drawing.Point(120, 60),
                Text = "Stop",
                Enabled = false
            };
            stopButton.Click += stopButton_Click;

            Controls.Add(countTextBox);
            Controls.Add(startButton);
            Controls.Add(stopButton);
        }

        // -------------------------------
        // Generate spiral scan
        // -------------------------------
        private List<(double X, double Y)> GenerateSpiralScan()
        {
            List<(double X, double Y)> pts = new List<(double X, double Y)>();

            double R = Math.Tan(16.6 * Math.PI / 180) / Math.Tan(50 * Math.PI / 180);
            int N = 5000;
            double turns = 15;

            for (int k = 0; k < N; k++)
            {
                double t = (double)k / (N - 1);
                double angle = turns * 2 * Math.PI * t;
                double radius = R * t;

                double x = radius * Math.Cos(angle);
                double y = radius * Math.Sin(angle);

                pts.Add((x, y));
            }

            return pts;
        }

        // -------------------------------
        // Start Button
        // -------------------------------
        private void startButton_Click(object sender, EventArgs e)
        {
            try
            {
                // -------------------------------
                // 1. Create counter task
                // -------------------------------
                myTask = new Task();

                // CHANGE ctr0/PFI0 to match your wiring
                myTask.CIChannels.CreateCountEdgesChannel(
                    "Dev1/ctr0",
                    "PhotonCounter",
                    CICountEdgesActiveEdge.Rising,
                    0,
                    CICountEdgesCountDirection.Up);

                myTask.CIChannels.All[0].CountEdgesTerminal = "/Dev1/PFI0";

                myTask.CIChannels.All[0].DigitalFilter.Enable = true;
                myTask.CIChannels.All[0].DigitalFilter.MinimumPulseWidth = 0.0000001;

                // -------------------------------
                // 2. Start counter ONCE
                // -------------------------------
                myTask.Start();
                counterReader = new CounterReader(myTask.Stream);
                previousReading = counterReader.ReadSingleSampleUInt32();

                // -------------------------------
                // Mirror connection
                // -------------------------------
                mirrorPort = new SerialPort("COM3", 256000);
                mirrorPort.NewLine = "\r\n";
                mirrorPort.Open();
                mirrorPort.WriteLine("start");

                // -------------------------------
                // Prepare scan
                // -------------------------------
                scanPoints = GenerateSpiralScan();
                scanIndex = 0;
                results = new List<ScanResult>();

                // -------------------------------
                // CSV file
                // -------------------------------
                string folder = @"C:\Users\user\Desktop\Single Photon Camera\CSV";
                Directory.CreateDirectory(folder);

                csvFilename = Path.Combine(folder,
                    $"PhotonScan_{DateTime.Now:yyyyMMdd_HHmmss}.csv");

                // -------------------------------
                // Begin scan
                // -------------------------------
                _ = RunScanAsync();

                startButton.Enabled = false;
                stopButton.Enabled = true;
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error starting scan:\n" + ex.Message);
            }
        }

        // -------------------------------
        // Scan Loop
        // -------------------------------
        private async System.Threading.Tasks.Task RunScanAsync()
        {
            try
            {
                while (scanIndex < scanPoints.Count)
                {
                    var p = scanPoints[scanIndex];

                    // Move mirror
                    mirrorPort.WriteLine($"xy= {p.X:F4}; {p.Y:F4}");

                    await System.Threading.Tasks.Task.Delay(1);

                    // Read counter
                    uint current = counterReader.ReadSingleSampleUInt32();

                    uint photonCount =
                        (current >= previousReading)
                            ? current - previousReading
                            : (current + 4294967296u) - previousReading;

                    previousReading = current;

                    // Store
                    results.Add(new ScanResult
                    {
                        Position = scanIndex,
                        X = p.X,
                        Y = p.Y,
                        Count = photonCount
                    });

                    countTextBox.Text = photonCount.ToString();

                    scanIndex++;
                }

                // Return mirror to center
                mirrorPort.WriteLine("xy=0;0");

                // Save CSV
                using (StreamWriter writer = new StreamWriter(csvFilename))
                {
                    writer.WriteLine("Position,X,Y,Count");
                    foreach (var r in results)
                    {
                        writer.WriteLine($"{r.Position},{r.X},{r.Y},{r.Count}");
                    }
                }

                MessageBox.Show("Scan complete.\nSaved to:\n" + csvFilename);

                stopButton.Enabled = false;
                startButton.Enabled = true;
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error during scan:\n" + ex.Message);
            }
        }

        // -------------------------------
        // Stop Button
        // -------------------------------
        private void stopButton_Click(object sender, EventArgs e)
        {
            try
            {
                if (mirrorPort != null && mirrorPort.IsOpen)
                {
                    mirrorPort.WriteLine("xy=0;0");
                    mirrorPort.Close();
                }

                if (myTask != null)
                {
                    myTask.Stop();
                    myTask.Dispose();
                }

                MessageBox.Show("Scan stopped.");
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error stopping scan:\n" + ex.Message);
            }

            startButton.Enabled = true;
            stopButton.Enabled = false;
        }
    }
}
