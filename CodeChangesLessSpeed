public async Task RunFullScanAsync()
{
    try
    {
        var fullScan = GenerateSpiralScan();
        scanResults = new List<ScanResult>();

        myTask.Start();
        previousReading = myCounterReader.ReadSingleSampleUInt32();

        Stopwatch scanTimer = Stopwatch.StartNew();

        int position = 0;

        foreach (var point in fullScan)
        {
            currentX = point.X;
            currentY = point.Y;

            // Move mirror
            mirrorPort.WriteLine($"xy= {currentX:F3}; {currentY:F3}");

            await Task.Delay(1);

            // Read counter
            uint currentReading = myCounterReader.ReadSingleSampleUInt32();
            uint photonCount = currentReading - previousReading;
            previousReading = currentReading;

            // Store result
            scanResults.Add(new ScanResult
            {
                Position = position,
                X = currentX,
                Y = currentY,
                Count = photonCount
            });

            // Update UI
            countTextBox.Text = photonCount.ToString();

            position++;
        }

        scanTimer.Stop();

        // Return mirror to centre
        mirrorPort.WriteLine("xy=0;0");

        // Write CSV
        using (StreamWriter writer = new StreamWriter(csvFilename, false))
        {
            writer.WriteLine("Position,X,Y,Count");

            foreach (var result in scanResults)
            {
                writer.WriteLine(
                    $"{result.Position}," +
                    $"{result.X.ToString(CultureInfo.InvariantCulture)}," +
                    $"{result.Y.ToString(CultureInfo.InvariantCulture)}," +
                    $"{result.Count}");
            }
        }

        // Stop DAQ
        myTask.Stop();
        myTask.Dispose();
        myTask = null;

        // Close mirror
        if (mirrorPort != null && mirrorPort.IsOpen)
            mirrorPort.Close();

        // Calculate scan speed
        double totalTime = scanTimer.Elapsed.TotalSeconds;
        double pointsPerSecond = scanResults.Count / totalTime;
        double averageTimePerPoint = totalTime / scanResults.Count * 1000.0;

        // Report results
        MessageBox.Show(
            "Scan complete.\n\n" +
            "Points: " + scanResults.Count + "\n" +
            "Time: " + totalTime.ToString("F2") + " s\n" +
            "Rate: " + pointsPerSecond.ToString("F1") + " points/s\n" +
            "Average point time: " + averageTimePerPoint.ToString("F2") + " ms\n\n" +
            "Saved to:\n" + csvFilename);

        startButton.Enabled = true;
        stopButton.Enabled = false;
    }
    catch (Exception ex)
    {
        MessageBox.Show("Error during scan:\n\n" + ex.Message);
        startButton.Enabled = true;
        stopButton.Enabled = false;
    }
}


